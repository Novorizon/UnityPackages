<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Shared.props" />
  <PropertyGroup>
    <AssemblyName>HybridCLR.Editor</AssemblyName>
    <DefineConstants>UNITY_EDITOR;UNITY_STANDALONE_WIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Engine/Engine.csproj" />
    <ProjectReference Include="../HybridRuntime/HybridRuntime.csproj" />
    <Compile Include="../HybridEditorBoundary.cs" />
    <Compile Include="$(HybridCLRPackageRoot)/Editor/CodeGen/**/*.cs" />
    <Compile Include="$(HybridCLRPackageRoot)/Editor/Meta/*.cs" />
    <Compile Include="$(HybridCLRPackageRoot)/Editor/Mod/*.cs" />
    <Compile Include="$(HybridCLRPackageRoot)/Editor/HotUpdate/MissingMetadataChecker.cs" />
    <Compile Include="$(HybridCLRPackageRoot)/Editor/Utils/MetaUtil.cs" />
    <Compile Include="$(HybridCLRPackageRoot)/Editor/Utils/HashUtil.cs" />
    <Compile Include="$(HybridCLRPackageRoot)/Editor/Commands/MethodBridgeGeneratorCommand.cs" />
    <Reference Include="dnlib"><HintPath>$(HybridCLRPackageRoot)/Plugins/dnlib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
